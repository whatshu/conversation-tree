CT_API_TOKEN=change-me-local-token
CT_OPENAI_BASE_URL=https://api.openai.com/v1
CT_OPENAI_API_KEY=change-me
CT_OPENAI_MODEL=gpt-4.1-mini
CT_SUMMARY_MODEL=gpt-4.1-mini
CT_DATABASE_URL=postgresql+psycopg://conversation_tree:conversation_tree@postgres:5432/conversation_tree
CT_LANGGRAPH_DATABASE_URL=postgresql://conversation_tree:conversation_tree@postgres:5432/conversation_tree
CT_LOG_LEVEL=INFO
CT_REQUEST_TIMEOUT_SECONDS=60
CT_MAX_PROMPT_CHARS=16000
CT_ENABLE_MOCK_PROVIDER=true
